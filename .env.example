# Copy to .env and set a unique SECRET_KEY before starting the backend.
APP_NAME=DeployGuard
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=r-
DATABASE_URL=sqlite+aiosqlite:///./deployguard.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AI_PROVIDER=fallback
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Optional GitHub token; public repositories work without one until rate-limited.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
VERIFICATION_RUNNER_TYPE=isolated_process
VERIFICATION_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
